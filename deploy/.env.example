# Copy to .env and replace the empty master key before starting the container.
# Generate a key with: openssl rand -hex 32
CODEXDECK_MASTER_KEY=

# Replace with the published GHCR image for this repository.
CODEXDECK_IMAGE=ghcr.io/waffing/codex-deck:latest

# Host loopback port mapped to the fixed container listener on port 3000.
CODEXDECK_BIND_PORT=3000
CODEXDECK_PORT=3000
CODEXDECK_HOST=0.0.0.0
# Host-process deployments stay disabled in production. Enable only on an
# explicitly isolated development machine.
CODEXDECK_ALLOW_LOCAL_DEPLOYMENTS=false

# Persistent data and the host source path mounted at /workspaces in the container.
CODEXDECK_DATA_PATH=./data
CODEXDECK_DATA_DIR=/data
CODEXDECK_WORKSPACES_HOST=./workspaces

# Container process identity and memory limit.
PUID=1000
PGID=1000
CODEXDECK_MEMORY_LIMIT=2g
# Set a public DNS name to enable the optional Caddy service profile.
CODEXDECK_DOMAIN=

# Set true when the console is reached through HTTPS, including an external TLS proxy.
CODEXDECK_COOKIE_SECURE=

# Comma-separated trusted private/loopback origins used for provider and preview callbacks.
CODEXDECK_TRUSTED_HTTP_ORIGINS=

# Keep at least the active and previous deployment release. Range: 2..100.
CODEXDECK_RELEASE_KEEP=5

# Optional native or self-hosted workload limits are enforced by the server.
# Current defaults are 1 CPU, 512 MiB and 128 PIDs per deployed workload.
